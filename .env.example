ENVIRONMENT=development
API_PREFIX=/api
LOG_LEVEL=INFO
LLM_PROVIDER=ollama
MODEL_NAME=qwen2.5-coder
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Docker Compose uses this host-reachable address when Ollama runs on your machine.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-techie
WORKSPACE_ROOT=.
MAX_WORKFLOW_ITERATIONS=20
PERSISTENCE_BACKEND=memory
DATABASE_URL=
REDIS_URL=
